---
Checks:
  - bugprone-*
  - clang-analyzer-*
  - concurrency-*
  - cppcoreguidelines-*
  - -cppcoreguidelines-avoid-c-arrays # alias
  - -cppcoreguidelines-avoid-magic-numbers # alias
  - -cppcoreguidelines-c-copy-assignment-signature # alias
  - -cppcoreguidelines-explicit-virtual-functions # alias
  - -cppcoreguidelines-macro-to-enum # alias
  - -cppcoreguidelines-narrowing-conversions # alias
  - -cppcoreguidelines-noexcept-destructor # alias
  - -cppcoreguidelines-noexcept-move-operations # alias
  - -cppcoreguidelines-noexcept-swap # alias
  - -cppcoreguidelines-non-private-member-variables-in-classes # alias
  - -cppcoreguidelines-use-default-member-init # alias
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*
CheckOptions:
  readability-identifier-length.IgnoredVariableNames: "_"
  readability-identifier-length.MinimumVariableNameLength: 2
  readability-identifier-length.MinimumParameterNameLength: 2
FormatStyle: file
HeaderFilterRegex: "src/.*"
